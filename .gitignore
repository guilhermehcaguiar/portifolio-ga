# Dependências instaladas
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Builds e caches gerados
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
/next-env.d.ts

# Resultados de testes e Playwright
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Ambiente local; manter somente o modelo público
.env*
!.env.example

# Configuração local da hospedagem
/.vercel/

# Logs de execução
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporários locais
/.tmp/
/tmp/
*.swp
*.swo
*~

# Arquivos do sistema (macOS e Windows)
.DS_Store
Thumbs.db
Desktop.ini

# Chaves e certificados locais
*.pem
*.key
*.p12
*.pfx

# Versionar .github/, docs/, public/, testes, scripts e package-lock.json.
# PDFs finais do currículo em public/curriculos/ também são arquivos públicos.
